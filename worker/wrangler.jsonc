{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finale-tmdb",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
